# URL du frontend, utilisée dans les liens envoyés par e-mail (réinitialisation de mot de passe)
FRONTEND_URL=http://localhost:3000

# SMTP — envoi des e-mails de réinitialisation de mot de passe.
# Pour Gmail : smtp.gmail.com, port 587, et un mot de passe d'application
# (https://myaccount.google.com/apppasswords) — pas votre mot de passe habituel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True
